# Application settings
STOCKML_APP_NAME=StockML API
STOCKML_ENVIRONMENT=local
STOCKML_DEBUG=false
STOCKML_LOG_LEVEL=INFO

# API settings
STOCKML_API__PREFIX=/api/v1
STOCKML_API__HOST=0.0.0.0
STOCKML_API__PORT=8000
STOCKML_API__RELOAD=false
STOCKML_API__CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Market data settings
STOCKML_MARKET_DATA__PROVIDER=yfinance
STOCKML_MARKET_DATA__INTERVAL=1d
STOCKML_MARKET_DATA__DEFAULT_HISTORY_YEARS=3
STOCKML_MARKET_DATA__REQUEST_TIMEOUT_SECONDS=30
STOCKML_MARKET_DATA__REQUEST_RETRIES=1
STOCKML_MARKET_DATA__CACHE_DIRECTORY=.cache/yfinance

# News settings
STOCKML_NEWS__ENABLED=true
STOCKML_NEWS__PROVIDER=tavily
STOCKML_NEWS__TAVILY_API_KEY="tvly-your-key-here"
STOCKML_NEWS__REQUEST_TIMEOUT_SECONDS=8
STOCKML_NEWS__MAX_ARTICLES_PER_ANOMALY=3
STOCKML_NEWS__MAX_ANOMALY_DAYS=2

# Model settings
STOCKML_MODEL__TRAINING_SPLIT_RATIO=0.8
STOCKML_MODEL__MINIMUM_TRAINING_ROWS=60
STOCKML_MODEL__HIDDEN_UNITS=64
STOCKML_MODEL__EPOCHS=100
STOCKML_MODEL__BATCH_SIZE=32
STOCKML_MODEL__RANDOM_SEED=42
